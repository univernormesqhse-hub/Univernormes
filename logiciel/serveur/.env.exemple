# Copiez ce fichier en « .env » (dans le même dossier) et remplissez ce qui vous concerne.
# Toutes les lignes sont facultatives.

# Port d'écoute et dossier où sont stockées la base et les photos (à sauvegarder !)
PORT=3000
# DATA_DIR=/var/lib/universnormes-qhse

# Adresse publique du logiciel, utilisée pour les liens dans les e-mails et WhatsApp
APP_URL=https://qhse.mon-entreprise.ci

# Mettre 1 si le logiciel est servi en HTTPS sans proxy qui transmet X-Forwarded-Proto
# COOKIE_SECURE=1

# ── Alertes par e-mail (SMTP : Gmail, Outlook, Brevo, OVH, serveur de l'entreprise…) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="UNIVERSNORMES QHSE <qhse@mon-entreprise.ci>"

# ── Alertes WhatsApp (API WhatsApp Cloud de Meta : developers.facebook.com → WhatsApp) ──
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Modèle de message approuvé avec une variable {{1}} : obligatoire pour écrire à quelqu'un qui n'a pas
# écrit au numéro de l'entreprise dans les dernières 24 h (cas normal des alertes).
WHATSAPP_TEMPLATE=
WHATSAPP_LANGUE=fr
# Indicatif ajouté aux numéros saisis sans « + » (225 = Côte d'Ivoire)
WHATSAPP_INDICATIF=225

# ── Récapitulatif quotidien ──
ALERTES_ACTIVES=1
ALERTES_HEURE=7
# Mettre 1 pour envoyer aussi le samedi et le dimanche
ALERTES_WEEKEND=0
