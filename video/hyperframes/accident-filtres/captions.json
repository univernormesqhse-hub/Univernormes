[
 {
  "text": "En management QHSE,",
  "start": 0.3,
  "end": 1.5
 },
 {
  "text": "la qualification d'un *accident*",
  "start": 1.53,
  "end": 3.35
 },
 {
  "text": "*du travail* répond à une",
  "start": 3.38,
  "end": 4.63
 },
 {
  "text": "mécanique juridique *stricte*.",
  "start": 4.66,
  "end": 6.47
 },
 {
  "text": "Prenez ce cas :",
  "start": 6.5,
  "end": 7.79
 },
 {
  "text": "à *14 heures* précises,",
  "start": 7.82,
  "end": 9.19
 },
 {
  "text": "un technicien *glisse* dans",
  "start": 9.22,
  "end": 10.23
 },
 {
  "text": "un entrepôt logistique",
  "start": 10.26,
  "end": 11.31
 },
 {
  "text": "et se *fracture le bras*.",
  "start": 11.34,
  "end": 12.91
 },
 {
  "text": "L'analyse commence par",
  "start": 12.94,
  "end": 13.99
 },
 {
  "text": "le *premier filtre* :",
  "start": 14.02,
  "end": 14.99
 },
 {
  "text": "le *fait accidentel*.",
  "start": 15.02,
  "end": 16.55
 },
 {
  "text": "L'événement doit être *soudain*",
  "start": 16.58,
  "end": 18.23
 },
 {
  "text": "et précisément *daté*,",
  "start": 18.26,
  "end": 19.59
 },
 {
  "text": "contrairement à une maladie",
  "start": 19.62,
  "end": 20.75
 },
 {
  "text": "qui s'installe dans le temps.",
  "start": 20.78,
  "end": 22.27
 },
 {
  "text": "Mais la soudaineté de la",
  "start": 22.3,
  "end": 23.31
 },
 {
  "text": "chute ne suffit *absolument pas*.",
  "start": 23.34,
  "end": 25.35
 },
 {
  "text": "Si le technicien se relève",
  "start": 25.38,
  "end": 26.75
 },
 {
  "text": "*indemne*,",
  "start": 26.78,
  "end": 27.31
 },
 {
  "text": "la qualification s'arrête",
  "start": 27.34,
  "end": 28.63
 },
 {
  "text": "net. Il faut prouver une",
  "start": 28.66,
  "end": 29.99
 },
 {
  "text": "*lésion corporelle*,",
  "start": 30.02,
  "end": 31.19
 },
 {
  "text": "qu'il s'agisse d'une fracture",
  "start": 31.22,
  "end": 32.43
 },
 {
  "text": "visible ou d'un traumatisme",
  "start": 32.46,
  "end": 33.75
 },
 {
  "text": "*psychologique*.",
  "start": 33.78,
  "end": 34.9
 },
 {
  "text": "Enfin, le *critère décisif*,",
  "start": 35.06,
  "end": 36.91
 },
 {
  "text": "qui engage la responsabilité",
  "start": 36.94,
  "end": 38.27
 },
 {
  "text": "de l'entreprise :",
  "start": 38.3,
  "end": 39.15
 },
 {
  "text": "le *lien avec le travail*.",
  "start": 39.18,
  "end": 40.71
 },
 {
  "text": "Il faut prouver que l'incident",
  "start": 40.74,
  "end": 41.99
 },
 {
  "text": "est bien survenu *sur le*",
  "start": 42.02,
  "end": 43.19
 },
 {
  "text": "*site* et *pendant les horaires*",
  "start": 43.22,
  "end": 44.35
 },
 {
  "text": "d'activité.",
  "start": 44.38,
  "end": 45.5
 },
 {
  "text": "Attention,",
  "start": 45.58,
  "end": 46.47
 },
 {
  "text": "ces *trois filtres* sont",
  "start": 46.5,
  "end": 47.31
 },
 {
  "text": "strictement *cumulatifs*.",
  "start": 47.34,
  "end": 48.94
 },
 {
  "text": "Si un seul de ces critères",
  "start": 49.06,
  "end": 50.15
 },
 {
  "text": "manque à l'appel,",
  "start": 50.18,
  "end": 50.95
 },
 {
  "text": "l'événement entier *perd*",
  "start": 50.98,
  "end": 52.11
 },
 {
  "text": "*son statut* officiel.",
  "start": 52.14,
  "end": 53.55
 },
 {
  "text": "Reprenons notre technicien :",
  "start": 53.58,
  "end": 55.27
 },
 {
  "text": "la chute à *14 heures* a",
  "start": 55.3,
  "end": 56.43
 },
 {
  "text": "bien provoqué une *fracture*,",
  "start": 56.46,
  "end": 57.99
 },
 {
  "text": "et ce, en plein milieu",
  "start": 58.02,
  "end": 59.11
 },
 {
  "text": "de l'*entrepôt*.",
  "start": 59.14,
  "end": 59.95
 },
 {
  "text": "L'équation est *complète*.",
  "start": 59.98,
  "end": 61.23
 },
 {
  "text": "L'accident du travail est",
  "start": 61.26,
  "end": 62.35
 },
 {
  "text": "*officiellement déclaré*.",
  "start": 62.38,
  "end": 64.02
 }
]